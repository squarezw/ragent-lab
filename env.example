# RAG Lab 环境变量配置示例
# 复制此文件为 .env 并填入你的实际配置

# OpenAI API 配置
OPENAI_API_KEY=your_openai_api_key_here

# Aliyun API 配置
Aliyun_API_KEY=your_aliyun_api_key

# 可选：代理配置（如果需要）
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=https://proxy.example.com:8080

# 可选：其他 API 配置
# HUGGINGFACE_API_TOKEN=your_huggingface_token_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 应用配置
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=localhost

# React + FastAPI production (server keys are opt-in, never sent to browsers)
ALLOW_SERVER_API_KEYS=false
ENABLE_HEAVY_MODELS=false

# Vision: built-in models (paid with the server's keys, unlocked by an access code).
# Unset LAB_ACCESS_CODE = no server models. One code unlocks every model; keys stay on the server.
# LAB_ACCESS_CODE=choose-a-long-random-code
# VISION_BUILTIN_PER_HOUR=60
# Key for the model catalog (Claude, GPT, Gemini, GLM, Kimi, Seed, MiniMax), see registry.py
# AIHUBMIX_API_KEY=sk-...
# Keys for VISION_BUILTIN_MODELS entries (key_env)
# DEEPSEEK_API_KEY=sk-...
# DASHSCOPE_API_KEY=sk-...
# LAB_LOG_LEVEL=INFO
# VISION_BUILTIN_MODELS=[{"id":"deepseek","name":"DeepSeek（内置）","api":"chat","url":"https://api.deepseek.com/chat/completions","model":"<vision model name>","key_env":"DEEPSEEK_API_KEY","json":"object"}]
# Optional per model: "extra":{"thinking":{"type":"disabled"}} is merged into the request body.
# Vision: uploaded drawings (Docker sets VISION_UPLOAD_DIR=/data/vision-uploads)
# VISION_UPLOAD_TTL_HOURS=168
